# ==============================================================================
# MaxMetagenome .gitignore
# 只追踪脚本、文档、配置文件；排除所有大型二进制/环境/数据库目录
# ==============================================================================

# Miniforge3 自包含环境（~27G）
miniforge3/

# Conda 工具环境（~23G）
envs/

# R 包库（~1.4G）
Rlib/

# 所有数据库（~700G）
db/

# 原始测序数据
seq/

# 分析中间文件
temp/

# 分析结果（本地生成，不入库）
result/

# 参考项目（大型 zip，通过 0Install.sh 注释说明下载方式）
Reference/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 系统文件
.DS_Store
*.swp
*.swo
*~

# conda 临时文件
.conda/
*.tar.gz
*.conda

# 日志
*.log

# 分析项目数据（测序数据/中间文件体积太大，不入库）
Project/*/data/
Project/*/temp/
Project/*/result/
