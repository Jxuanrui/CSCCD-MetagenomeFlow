# ==============================================================================
# 防止工具在项目根目录创建临时文件/目录（2026-06-17 路径清理后添加）
# ==============================================================================

# R 默认图形设备：未指定输出设备时在 cwd 生成空 Rplots.pdf（已在脚本中修复 cwd）
/Rplots.pdf

# PhyloPhlAn/StrainPhlAn4 默认数据库目录（已在脚本中修复，但仍防御）
/phylophlan_databases/

# Eukfinder 日志（应在 Project/*/logs/fungi/ 下，但 Eukfinder 会在调用目录写日志）
/Long_seqs_*.log

# 统计脚本测试数据（应在 temp/ 下，但历史遗留问题）
/Project/*/test_data/

# 其他可能的临时数据库目录
/*_database/
/*_databases/
/*_db/

# 临时文件模式
/*.tmp
/*.temp
/*.cache

# 根目录 temp/ 与 logs/（工作临时区，内容不入库；由 *.log 等模式覆盖不到的非日志文件防御）
/temp/
/logs/

# Omo codegraph 符号链接（指向 ~/.omo，机器本地）
/.codegraph

# Claude Code 运行时文件（session lock，不入库）
.claude/scheduled_tasks.lock

# RAG 索引缓存（可通过 mcp/indexer.py / mcp/bm25_index.py 重建，不入库）
mcp/bm25_data/*.pkl
# RAG benchmark 运行产物（带时间戳的结果 JSON，不入库）
mcp/eval/results/

# OpenCode 运行时目录（不入库）
.omo/

# ScientificFigureLibrary 本地部署（Node 构建产物，体积大，不入库；由 tools/sfl_dl 的 Release ZIP 还原）
tools/ScientificFigureLibrary/
tools/sfl_dl/

# Paper2Agent 本地部署（第三方 skill 工作流，按需 git clone 还原）
tools/Paper2Agent/

# ScientificFigureLibrary 的图件模板库（用户数据，机器本地，不入库）
FigureLibrary/

# ZCode client session artifacts (plans etc., machine-local)
.zcode/

# auto-mining: regenerable data artifact (see mining/seed_summary.json for provenance)
mining/seed_registry.sqlite

# auto-mining runtime state (regenerable)
mining/incremental_state.json
mining/incremental_last_run.json
mining/incremental_cron.log
mining/projects/
mining/vis/
mining/curation.sqlite
mining/curation_run.jsonl
mining/sources/raw/
mining/curation_cron.log
mining/snapshots/api_cache/

# M4 MVP: downloaded microbiome profiles (regenerable, ~8 GB budget)
mining/m4/profiles/
mining/m4/annotations_cache.jsonl
