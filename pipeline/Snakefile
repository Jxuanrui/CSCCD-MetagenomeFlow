            STAT_FUNC_DIMENSIONS, STAT_FUNC_TYPES),
        _e("{workdir}/result/stat/{dimension}/functional/{dimension}_permanova_done.txt",
           dimension=STAT_DIMENSIONS),
        _e("{workdir}/result/stat/{dimension}/functional/network/{dimension}_functional_network_done.txt",
           dimension=STAT_DIMENSIONS),
        _e("{workdir}/result/stat/{dimension}/functional/00_summary/{dimension}_summary_done.txt",
           dimension=STAT_DIMENSIONS),
        WORKDIR + "/result/stat/cross_dimension/functional/cross_dimension_functional_done.txt",
        WORKDIR + "/result/stat/bacteria/lefse/.done",
        WORKDIR + "/result/stat/virus/lefse/.done",
        WORKDIR + "/result/stat/fungi/lefse/.done",
        WORKDIR + "/result/stat/bacteria/core_microbiome/core_microbiome_summary.txt",
        WORKDIR + "/result/stat/fungi/core_microbiome/core_microbiome_summary.txt",
        WORKDIR + "/result/stat/virus/core_microbiome/core_microbiome_summary.txt",
        WORKDIR + "/result/stat/bacteria/functional_redundancy/functional_redundancy_summary.txt",
        WORKDIR + "/result/stat/fungi/functional_redundancy/functional_redundancy_summary.txt",
        WORKDIR + "/result/stat/virus/functional_redundancy/functional_redundancy_summary.txt",
        WORKDIR + "/result/stat/bacteria/pathway_activity/pathway_completeness_summary.csv",
        WORKDIR + "/result/stat/downstream_summary.tsv",
    ]

    targets = list(shared)
    if "bacteria" in KINGDOMS:
        targets += bacteria
    if "fungi" in KINGDOMS:
        targets += fungi
    if "virome" in KINGDOMS:
        targets += virome
    if FULL_RUN:
        targets += full_run
    return targets


rule all:
    input:
        _all_targets()
