    virome = [
        _e("{workdir}/result/virus/checkv/{sample}/quality_summary.tsv", sample=SAMPLES),
        WORKDIR + "/result/virus/votu/votu_representatives.tsv",
        WORKDIR + "/result/virus/votu/genomad/virus_taxonomy.tsv",
        WORKDIR + "/result/virus/votu/table/vOTU_table_ann.txt",
