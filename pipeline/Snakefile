    ]

    full_run = [
        WORKDIR + "/result/cross_domain/cluster/genome_clusters.tsv",
        WORKDIR + "/result/cross_domain/orthogroup/orthogroup_table.tsv",
        WORKDIR + "/result/cross_domain/correlation/network_summary.txt",
        WORKDIR + "/result/stat/metadata.tsv",
        WORKDIR + "/result/stat/metadata_qc_report.txt",
        WORKDIR + "/result/stat/metadata_status.tsv",
        WORKDIR + "/result/stat/diversity_alpha_summary.tsv",
