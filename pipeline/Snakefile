        _e("{workdir}/result/fungi/veba_qc/{sample}/euk_mags/{sample}.euk_mags_summary.tsv", sample=SAMPLES),
        _e("{workdir}/result/fungi/veba_qc/{sample}/euk_mags/{sample}.metaeuk_done.txt", sample=SAMPLES),
        _e("{workdir}/result/fungi/prodigal/{sample}/{sample}.faa", sample=SAMPLES),
        WORKDIR + "/result/fungi/eggnog/eggnog.emapper.annotations",
        WORKDIR + "/result/fungi/kegg/kegg_diamond.tsv",
        WORKDIR + "/result/fungi/dbcan/overview.txt",
        WORKDIR + "/result/fungi/vfdb/vfdb_hits.tsv",
        WORKDIR + "/result/fungi/amr/amrfinder_results.tsv",
        WORKDIR + "/result/fungi/merops/merops_hits.tsv",
