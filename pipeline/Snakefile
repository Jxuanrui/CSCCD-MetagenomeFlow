        WORKDIR + "/result/virus/pharokka/pharokka_cds_final_merged_output.tsv",
        WORKDIR + "/result/virus/phold/vOTU_phold.tsv",
        WORKDIR + "/result/virus/vog/vog_annot.tsv",
        WORKDIR + "/result/virus/bacphlip/bacphlip_results.tsv",
        WORKDIR + "/result/virus/iphop/Host_prediction_to_genus_m90.csv",
